# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le modèle, qui ne contient que des NOMS de variables : c'est le
# seul endroit où l'on découvre qu'il faut une clé Google pour les avis.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
